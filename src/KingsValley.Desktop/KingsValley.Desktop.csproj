<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>KingsValley2</AssemblyName>
    <Version>1.1.3</Version>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Insumo de build (o import do MsxAudioTool lê estes arquivos), não conteúdo de runtime:
         o jogo lê apenas Content/Rom/Audio/audio.msxaudio. -->
    <None Remove="Content\Rom\Audio\Vgm\**\*.*" />
    <None Remove="Content\Rom\Audio\audio.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KingsValley.Core\KingsValley.Core.csproj" />
    <ProjectReference Include="..\KingsValley.Engine\KingsValley.Engine.csproj" />
  </ItemGroup>
</Project>
